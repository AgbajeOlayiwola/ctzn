# Copy this file to .env.local and fill in your Supabase project values.
# Without them the app still runs, using sample data saved in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional interactive Google map and Street View in the reporting flow.
# Enable Maps JavaScript API with billing in Google Cloud. This is a browser key:
# restrict it to your website HTTP referrers and the Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
